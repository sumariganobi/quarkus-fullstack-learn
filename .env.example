# Database Configuration
# Copy this file to .env and fill with your actual credentials
# DO NOT commit .env file to git!

DB_USERNAME=ns
DB_PASSWORD=your_password_here
DB_URL=jdbc:mysql://localhost:3306/quarkus_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# Docker Compose Configuration
DB_ROOT_PASSWORD=your_root_password_here
DB_NAME=quarkus_db
DB_PORT=3306
